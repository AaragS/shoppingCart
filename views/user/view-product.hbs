<section>
<div class="container mt-5">
    <div class="row">
        {{#each products}}
        <div class="col-md-3">
            <div class="card mt-5 p-3" style="width: 15rem; height:25rem">
                <img class="card-img-top" src="/product-images/{{this._id}}.jpg" style="height:13rem; width:10rem;" salt="Card image cap">
                <div class="card-body">
                    <h5 class="card-title">{{this.name}}</h5>
                    <p class="card-text"> {{this.Company}}</p>
                    <p class="card-text">RS.{{this.Price}}</p>
                    <button class="btn btn-primary"  onclick="AddToCart('{{this._id}}')">Add to Cart</button>
                </div>
            </div>
        </div>
         {{/each}}
    </div>
</div>
</section>