<section>
<div class="container mt-5">
    <div class="row">
        {{#each ordered_products}}
        <div class="col-md-3">
            <div class="card mt-5 p-3" style="width: 15rem; height:25rem">
                <img class="card-img-top" src="/product-images/{{this.product._id}}.jpg" style="height:13rem; width:10rem;" salt="Card image cap">
                <div class="card-body">
                    <h5 class="card-title">title:n{{this.product.name}}</h5>
                    <p class="card-text"> company:{{this.product.Company}}</p>
                    <p class="card-text">price :Rs.{{this.product.Price}}</p>
                    <p class="card-text">quantity:{{this.quantity}}</p>
                    
                  
                </div>
            </div>
        </div>
         {{/each}}
    </div>
</div>
</section>