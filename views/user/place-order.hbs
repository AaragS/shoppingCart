<form action="/place-order" id="checkout-form" method="post">
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-6">
                <h1>Enter Delivery adress</h1><br><br>
                <label >Address</label>
                <input type="text" name="address" class="form-control " >
                <label >Pincode</label>
                <input type="text" name="pincode" class="form-control ">
                <label >Mobile</label>
                <input type="text" name="mobile" class="form-control ">
                <input type="hidden" name="userId" value="{{user._id}}">
            </div>
            <div class="col-md-4  mt-5 checkout" style="border: 2px solid #000;" >
                <div class="container mt-3">
                <h4>Total Amount:{{total}}</h3>
                <hr><br>
                <div class="payment">
                <h5>Payment method</h5><br>

                <label class="radio-inline">
                    <input type="radio" name="payment-method" id="" value="COD">COD
                </label>
                <br>
                <label class="radio-inline">
                    <input type="radio" name="payment-method" id="" value="ONLINE">Online Payement
                </label>
                     
                   <button type="submit" class="btn btn-success float-right mt-3">checkout</button>
               
               
            
                </div>
                
                    
             </div>
            </div>
        </div>
    </div>
</form>

