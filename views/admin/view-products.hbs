<div class="container">
<section>

    <div class="container">
        <div class="row ">
        <a href="/admin/add-products" class="btn btn-success mt-3 ml-auto">Add product</a>
    </div>
    </div>

    <table class="table mt-4">
  <thead>
    <tr>
      <th scope="col">No</th>
      <th scope="col">Title</th>
      <th scope="col">Company</th>
      <th scope="col">Price</th>
      <th scope="col">Img</th>
    </tr>
  </thead>
  <tbody>
    {{#each products}}
    <tr>
      <th scope="row">1

      </th>
      <td>{{this.name}}</td>
      <td>{{this.Company}}</td>
      <td>{{this.Price}}</td>
      <td><img src="/product-images/{{this._id}}.jpg" height="50px" width="50px" srcset=""></td>
      <td>
        <a class="btn btn-primary" href="/admin/edit-products/{{this._id}}">Edit</a>
        <a class="btn btn-danger" onclick="return confirm('are you sure to delete ')" href="/admin/delete-product/{{this._id}}">Delete</a>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
</section>

</div>